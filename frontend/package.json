{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "installprod": "npm install --production",
    "esbuild": "./esbuild.js",
    "esstart": ". ./.env; if [ $ESBUILD_DONT_SERVE = \"yes\" ]; \n then \n ./esbuild.js watch \n else \n ./run-parallel.sh \"npx serve -s ./build -p 3000\" \"./esbuild.js watch\" \n fi",
    "start": ". ./.env; react-scripts start",
    "build": ". ./.env; react-scripts build",
    "servebuilt": "npx serve -s build/ -p 3000 --no-clipboard",
    "buildprod": ". ./.env; react-scripts build && rm -rf prodbuild && cp -r build prodbuild",
    "serveprod": "npx serve -s prodbuild/ -p 8000 --no-clipboard",
    "ios": ". ./.env; react-scripts build && npx cap copy ios && npx cap open ios",
    "format": "eslint --config=.eslintrc-format.json --fix --ext .js,.jsx,.ts,.tsx src",
    "lint": "eslint src",
    "strictcheck": "tsc -p tsconfig-strict.json",
    "test": "react-scripts test",
    "generateicons": "npx cordova-res ios --skip-config --copy; npx cordova-res android --skip-config --copy",
    "tsc": "tsc"
  },
  "eslintConfig": {
    "extends": "./.eslintrc.json"
  },
  "dependencies": {
    "@capacitor/core": "^3.1.2",
    "@capacitor/haptics": "^1.0.2",
    "@capacitor/share": "^1.0.3",
    "@reach/checkbox": "^0.16.0",
    "@reach/slider": "^0.15.3",
    "ahooks": "^2.10.8",
    "d3-array": "^3.0.1",
    "dotenv": "^10.0.0",
    "esbuild": "^0.12.22",
    "firebase": "^9.0.1",
    "immer": "^8.0.1",
    "lodash": "^4.17.21",
    "mini-svg-data-uri": "^1.3.3",
    "peerjs": "1.3.2",
    "react": "^17.0.2",
    "react-colorful": "^5.3.0",
    "react-dom": "^17.0.2",
    "react-hot-toast": "^2.1.0",
    "styled-components": "^5.3.0",
    "three": "^0.130.1",
    "touch-pinch": "^1.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^3.1.2",
    "@capacitor/cli": "^3.1.2",
    "@capacitor/ios": "^3.1.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^12.0.0",
    "@testing-library/user-event": "^13.2.0",
    "@types/lodash": "^4.14.171",
    "@types/react": "^17.0.14",
    "@types/styled-components": "^5.1.11",
    "@typescript-eslint/eslint-plugin": "^4.28.4",
    "@typescript-eslint/parser": "^4.28.4",
    "eslint": "^7.31.0",
    "eslint-plugin-react": "^7.24.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "react-scripts": "4.0.3",
    "typescript": "^4.3.5",
    "typescript-strict-plugin": "^1.1.0"
  },
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  }
}
