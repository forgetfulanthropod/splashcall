# Copy to frontend/.env if you are building in a cloud shell that has a copy of these values.
# Cloud builds normally set the same names as GitHub environment variables.
# Do not commit a filled-in .env. This repository is public.

# Hostname of the peer signaling server only. No https:// and no port.
# Example: signal.example.com
# Leave blank to build an app that still opens; calls stay disconnected until this is set.
REACT_APP_BACKEND_URL=

# Set to yes only when the peer server is the local one on port 9000.
REACT_APP_IS_LOCAL=

# Optional Firebase. Leave blank and the app skips Firebase.
REACT_APP_FIRE_API_KEY=
REACT_APP_FIRE_AUTH_DOMAIN=
REACT_APP_FIRE_PROJECT_ID=
REACT_APP_FIRE_STORAGE_BUCKET=
REACT_APP_FIRE_MESSAGING_SENDER_ID=
REACT_APP_FIRE_APP_ID=
REACT_APP_FIRE_MEASUREMENT_ID=

# Optional. When set, the phone app loads this website instead of the copy packed into the app.
# Example for a live-reload experiment: https://your-preview-host.example
CAP_SERVER_URL=
